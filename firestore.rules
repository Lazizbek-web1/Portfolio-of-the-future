rules_version = '2';

// Visitors may only drop a message in; nobody can read, edit or delete through the API.
// Read messages in the Firebase console (Firestore > messages).
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{id} {
      allow create: if validMessage(request.resource.data);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function validMessage(d) {
      return d.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'page'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.message is string && d.message.size() > 0 && d.message.size() <= 3000
        && (!('page' in d) || (d.page is string && d.page.size() <= 200))
        && d.createdAt == request.time;
    }
  }
}
